@model NeoSoft.A2ZFiling.UI.ViewModels.DocumentMasterVM;

@{
    ViewData["Title"] = "Create";
    
}

<!-- Create Modal -->     @*  modal-dialog-centered
@ <div id="createModal" class="modal" tabindex="-1" role="dialog"> @ *@
<!-- Modal Structure -->
<div id="updateModal" class="modal fade">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Update Document Master</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="error-message-container-update"></div>
                <form id="updateDocumentForm" asp-action="Update" asp-controller="DocumentMaster" method="post" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <input asp-for="DocumentMasterId" hidden />
                    <div class="form-group">
                        <label asp-for="DocumentName">Document Name:</label>
                        <input asp-for="DocumentName" class="form-control" />
                        <span asp-validation-for="DocumentName" class="text-danger" id="entityName"></span>
                    </div>
                    <div class="form-group">
                        @Html.Label("Current Document")
                        <div>
                            @if (!string.IsNullOrEmpty(Model.SampleFormat))
                            {
                                <a href="~/@Model.SampleFormat" >View Document</a>
                            }
                            else
                            {
                                <span>No document uploaded</span>
                            }
                        </div>
                    </div>
                    <div class="form-group">
                        <label asp-for="SampleFormatFile">File:</label>
                        <input type="file" asp-for="SampleFormat" name="SampleFormatFile" class="form-control" />
                    </div>
                    <div class="form-group">
                        <label asp-for="DocumentFormat">Select Document Format:</label>
                        @foreach (var opt in Model.FormatList)
                        {
                            <input type="checkbox" name="DocumentFormatList" value="@opt" checked="@(Model.DocumentFormatList.Contains(opt) ? "checked" : null)" />
                            <label>@opt</label>
                        }
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary" id="updateDocumentButton">Save</button>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        // function reloadPage() {
        //     window.location.reload()
        // }

        // function submitForm() {
        //     document.getElementById('createDocumentForm').submit();
        // }
    </script>
}