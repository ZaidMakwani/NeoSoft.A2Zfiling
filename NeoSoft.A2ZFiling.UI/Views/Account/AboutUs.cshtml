@model NeoSoft.A2ZFiling.UI.ViewModels.AboutVM
@using System.Net
@{
    ViewData["Title"] = "about";
    Layout = "_Layout"; // This ensures the page does not use a shared layout
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>about of Use - A2Z-LandingPage</title>
    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
    <style>
        /* Custom styles specific to Terms of Use page */
        body {
            font-family: Arial, sans-serif;
        }

        .terms-section {
            padding: 50px 20px;
            background: white;
            border-radius: 10px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        }

            .terms-section h2 {
                font-size: 2.5em;
                margin-bottom: 30px;
            }

            .terms-section p {
                font-size: 1.1em;
                line-height: 1.6;
            }
    </style>
</head>
<body>
    <div class="container mt-5">
        <div class="row">
            <div class="col-md-8 offset-md-2">
                <div class="terms-section">
                    @Html.Raw(WebUtility.HtmlDecode(Model.About))
                </div>
            </div>
        </div>
    </div>
    <div class="form-group text-center">
     @*    @if (TempData["Role"].ToString() == "Admin")
        {
            <a type="submit" asp-controller="Account" asp-action="EditAboutUs" class="btn btn-success mr-2">Edit</a>
        } *@
        <a type="submit" asp-controller="Account" asp-action="EditAboutUs" class="btn btn-success mr-2">Edit</a>

        <a type="button" asp-controller="Account" asp-action="Index" class="btn btn-secondary mr-2">Back</a>

    </div>



    <!-- Bootstrap JS -->
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/1.16.0/umd/popper.min.js"></script>
    <script src="https://maxcdn.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
</body>
</html>
