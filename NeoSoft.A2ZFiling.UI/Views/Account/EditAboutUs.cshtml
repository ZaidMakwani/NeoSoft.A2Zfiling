@model NeoSoft.A2ZFiling.UI.ViewModels.AboutVM;
@using System.Net

@{
    ViewData["Title"] = "EDIT";
    Layout = "_Layout"; // This ensures the page does not use a shared layout
}

    <style>



    #editor-container {
        display: flex;
        flex-direction: column;
        width: 80%;
        max-width: 800px;
        background-color: white;
        padding: 20px;
        border-radius: 8px;
        box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
        margin-top: 20px;
        margin-left: 274px;
    }

        #iframe-container {
            flex-grow: 1;
        }

        #toolbar {
            margin-bottom: 10px;
            display: flex;
            flex-wrap: wrap;
        }

        #richTextField {
            width: 100%;
            height: 400px;
            border: 1px solid #ccc;
            padding: 10px;
            box-sizing: border-box;
        }

        button, select, input[type="color"], input[type="file"] {
            margin-right: 5px;
            padding: 5px 10px;
            font-size: 16px;
        }

        button {
            cursor: pointer;
        }

        input[type="file"] {
            display: none;
        }

        .dark {
            background-color: #333;
            color: #fff;
        }

        .light {
            background-color: #fff;
            color: #000;
        }
    </style>

<body>
    <div id="editor-container">
        <div id="toolbar">
            <button onclick="execCmd('bold')"><b>B</b></button>
            <button onclick="execCmd('italic')"><i>I</i></button>
            <button onclick="execCmd('underline')"><u>U</u></button>
            <select id="fontSize" onchange="execCmdWithArg('fontSize', this.value)">
                <option value="1">10px</option>
                <option value="2">13px</option>
                <option value="3">16px</option>
                <option value="4">18px</option>
                <option value="5">24px</option>
                <option value="6">32px</option>
                <option value="7">48px</option>
            </select>
            <input type="color" id="fontColor" onchange="execCmdWithArg('foreColor', this.value)">
            <button onclick="execCmd('insertUnorderedList')">UL</button>
            <button onclick="execCmd('insertOrderedList')">OL</button>
            <button onclick="execCmd('justifyLeft')">Left</button>
            <button onclick="execCmd('justifyCenter')">Center</button>
            <button onclick="execCmd('justifyRight')">Right</button>
            <button onclick="execCmd('justifyFull')">Justify</button>
            <button onclick="execCmd('undo')">Undo</button>
            <button onclick="execCmd('redo')">Redo</button>
            <input type="file" id="imgUploader" onchange="insertImage()">
            <label for="imgUploader">Insert Image</label>
            <select id="style-select" onchange="applyStyle()">
                <option value="default">Default Style</option>
                <option value="dark">Dark Mode</option>
                <option value="light">Light Mode</option>
            </select>
            <button id="view-html" onclick="toggleHTML()">View HTML</button>
        </div>
        <iframe id="richTextField" name="richTextField"></iframe>
        <form action="@Url.Action("EditAboutUs", "Account")" method="post">
            <input type="hidden" name="htmlContent" id="htmlContent">
            <input type="hidden" name="tid" id="tid">
            <button type="submit" onclick="saveContent()">Save Content</button>
        </form>
    </div>
    <br>

    <script>
        document.addEventListener('DOMContentLoaded', (event) => {
            debugger
            // Enable design mode
            const iframe = document.getElementById('richTextField');
            iframe.contentDocument.designMode = 'On';

            // Initialize the iframe with default content
            // iframe.contentDocument.body.textContent = te;
            iframe.contentDocument.body.innerHTML = `@Html.Raw(WebUtility.HtmlDecode(Model.About))`;
        });

        function execCmd(command) {
            document.getElementById('richTextField').contentDocument.execCommand(command, false, null);
        }

        function execCmdWithArg(command, arg) {
            document.getElementById('richTextField').contentDocument.execCommand(command, false, arg);
        }

        function insertImage() {
            const file = document.getElementById('imgUploader').files[0];
            const reader = new FileReader();

            reader.onload = function (e) {
                const imgHTML = `<img src="${e.target.result}" alt="Image">`;
                execCmdWithArg('insertHTML', imgHTML);
            }

            if (file) {
                reader.readAsDataURL(file);
            }
        }

        function applyStyle() {
            const style = document.getElementById('style-select').value;
            const iframeBody = document.getElementById('richTextField').contentDocument.body;

            iframeBody.classList.remove('dark', 'light');

            if (style === 'dark') {
                iframeBody.classList.add('dark');
            } else if (style === 'light') {
                iframeBody.classList.add('light');
            }
        }

        function toggleHTML() {
            const iframe = document.getElementById('richTextField');
            const button = document.getElementById('view-html');

            if (button.textContent === 'View HTML') {
                const htmlContent = iframe.contentDocument.body.innerHTML;
                iframe.contentDocument.body.textContent = htmlContent;
                button.textContent = 'View Editor';
            } else {
                const textContent = iframe.contentDocument.body.textContent;
                iframe.contentDocument.body.innerHTML = textContent;
                button.textContent = 'View HTML';
            }
        }

        function saveContent() {
            const iframe = document.getElementById('richTextField');
            const content = iframe.contentDocument.body.innerHTML;
            document.getElementById('htmlContent').value = content;
            document.getElementById('tid').value = @Model.Id;
        }
    </script>
    <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>

</body>
