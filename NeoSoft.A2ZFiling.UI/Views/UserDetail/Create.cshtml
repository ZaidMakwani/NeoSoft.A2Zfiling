    .StepProgress {
        position: relative;
        padding-left: 45px;
        list-style: none;
    }

        .StepProgress::before {
            display: inline-block;
            content: '';
            position: absolute;
            top: 0;
            left: 15px;
            width: 10px;
            height: 100%;
        }

    .StepProgress-item {
        position: relative;
        counter-increment: list;
    }

        .StepProgress-item:not(:last-child) {
            padding-bottom: 20px;
        }

        .StepProgress-item::before {
            display: inline-block;
            content: '';
            position: absolute;
            left: -30px;
            height: 100%;
            width: 10px;
        }

        .StepProgress-item::after {
            content: '';
            display: inline-block;
            position: absolute;
            top: 0;
            left: -37px;
            width: 20px;
            height: 20px;
            border: 2px solid #CCC;
            border-radius: 50%;
            background-color: #FFF;
        }

        .StepProgress-item.is-done::before {
            border-left: 2px solid green;
        }

        .StepProgress-item.is-done::after {
            content: "✔";
            font-size: 13px;
            color: #FFF;
            text-align: center;
            border: 2px solid green;
            background-color: green;
        }

        .StepProgress-item.current::before {
            border-left: 2px solid green;
        }

        .StepProgress-item.current::after {
            content: counter(list);
            padding-top: 1px;
            width: 25px;
            height: 25px;
            top: -4px;
            left: -40px;
            font-size: 14px;
            text-align: center;
            color: green;
            border: 2px solid green;
            background-color: white;
        }

    .file-upload-container {
        border: 1px solid #ccc;
        padding: 20px;
        margin-bottom: 20px;
        border-radius: 10px;
        position: relative;
    }

    .file-upload-section {
        display: flex;
        align-items: center;
        margin-bottom: 10px;
    }

</style>
@* </head> *@

<body>
        <div class="container">
            <aside class="sidebar1">
            <h2>Welcome!<br>@TempData["Username"]</h2>
                <div class="wrapper">
                    <ul class="StepProgress">
                        <li class="StepProgress-item is-done"><strong>Registration <br>Completed</strong></li>
                        <li class="StepProgress-item current"><strong>Upload Documents</strong></li>
                        <li class="StepProgress-item current"><strong>Process Payment</strong></li>
                        <li class="StepProgress-item current"><strong>Executive Assigned</strong></li>
                        <li class="StepProgress-item current"><strong>Application Submitted <br>To Authority</strong></li>
                        <li class="StepProgress-item current"><strong>Application Under <br>Process With Authority</strong></li>
                        <li class="StepProgress-item current"><strong>Registration <br>Completed</strong></li>
                        <li class="StepProgress-item current"><strong>Courier Dispatch <br>Status</strong></li>
                    </ul>
                </div>
            </aside>

            <div class="main-content">
                <h2>Upload Documents</h2>
            <p>Kindly proceed to upload documents for <strong>@TempData["Service"]</strong></p>

                <form enctype="multipart/form-data" asp-action="Create" asp-controller="UserDetail" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="mb-3">
                        <label for="CompanyName" class="form-label">Company Registered Name</label>
                        <input type="text" asp-for="CompanyName" class="form-control" id="CompanyName" size="60">
                        <span asp-validation-for="CompanyName" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label for="CompanyAddress" class="form-label">Company Registered Address</label>
                        <input type="text" asp-for="CompanyAddress" class="form-control" id="CompanyAddress" size="60">
                        <span asp-validation-for="CompanyAddress" class="text-danger"></span>
                    </div>

                    <div class="row mb-3">
                        <div class="col">
                            <label for="CompanyId" class="form-label">Select Company Type</label>
                            <select class="form-select" aria-label="Select Company Type" asp-for="CompanyId" required>
                                <option value="">Select Company Type</option>
                                @foreach (var company in ViewBag.Companies as SelectList)
                                {
                                    <option value="@company.Value">@company.Text</option>
                                }
                            </select>
                            <span asp-validation-for="CompanyId" class="text-danger"></span>
                        </div>

                        <div class="col">
                            <label for="IndustryId" class="form-label">Select Industry Type</label>
                            <select class="form-select" aria-label="Select Industry Type" asp-for="IndustryId" required>
                                <option value="">Select Industry Type</option>
                                @foreach (var industry in ViewBag.Industries as SelectList)
                                {
                                    <option value="@industry.Value">@industry.Text</option>
                                }
                            </select>
                            <span asp-validation-for="IndustryId" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col">
                            <label for="StateId" class="form-label">Select State</label>
                            <select class="form-select" aria-label="Select State" asp-for="StateId" id="state-dropdown" required>
                                <option value="">Select State</option>
                                @foreach (var state in ViewBag.States as SelectList)
                                {
                                    <option value="@state.Value">@state.Text</option>
                                }
                            </select>
                            <span asp-validation-for="StateId" class="text-danger"></span>
                        </div>

                        <div class="col">
                            <label for="CityId" class="form-label">Select City</label>
                            <select class="form-select" aria-label="Select City" asp-for="CityId" id="city-dropdown" required>
                                <option value="">Select City</option>
                                @foreach (var city in ViewBag.Cities as SelectList)
                                {
                                    <option value="@city.Value">@city.Text</option>
                                }
                            </select>
                            <span asp-validation-for="CityId" class="text-danger"></span>
                        </div>

                        <div class="col">
                            <label for="MunicipalId" class="form-label">Select Municipality</label>
                            <select class="form-select" aria-label="Select Municipality" asp-for="MunicipalId" required>
                                <option value="">Select Municipality</option>
                                @foreach (var municipal in ViewBag.Municipalies as SelectList)
                                {
                                    <option value="@municipal.Value">@municipal.Text</option>
                                }
                            </select>
                            <span asp-validation-for="MunicipalId" class="text-danger"></span>
                        </div>
                    </div>

                    <section class="mb-3">
                        <h5><strong>List of Documents</strong></h5>

                        <div class="file-upload-container">
                            @{
                                var documentList = ViewBag.DocumentName as SelectList;
                            }
                            @foreach (var item in documentList)
                            {
                                <div class="file-upload-section">
                                    <label for="file@(item.Value)" style="flex: 1;"><strong>@item.Text</strong></label>
                                    <input type="hidden" name="DocumentMasterId" value="@item.Value" />
                                    <input type="file" id="file@(item.Value)" name="FileName" class="form-control" multiple>
                                    <span asp-validation-for="FileName" class="text-danger"></span>
                                </div>
                                @if (!item.Equals(documentList.Last()))
                                {
                                    <hr />
                                }
                            }
                        </div>
                    </section>

                    <div class="text-center">
                        <button type="submit" class="btn btn-primary" style="font-weight: bold;">Submit Documents</button>
                    </div>
                </form>
            </div>
        </div>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.min.js"
            integrity="sha384-0pUGZvbkm6XF6gxjEnlmuGrJXVbNuzT9qBBavbLwCsOGabYfZo0T0to5eqruptLy" crossorigin="anonymous">
    </script>
    <script src="https://kit.fontawesome.com/a076d05399.js"></script>

    <script>
        $(document).on('submit', 'form', function () {
            var createUrl = '@Url.Action("Create", "UserDetail")';
            $.ajax({
                url: createUrl,
                type: 'POST',
                data: new FormData(this),
                contentType: false,
                processData: false,
                success: function (data) {
                    console.log("Details created successfully");
                    const progressItems = document.querySelectorAll('.StepProgress-item');
                    progressItems[1].classList.remove('current');
                    progressItems[1].classList.add('is-done');
                },
                error: function (xhr, status, error) {
                    console.error("Error creating user detail : ", error);
                    alert("Error fetching user detail . Please try again.");
                }
            });
            return false;
        });


        //Cascading dropdown
        $(document).ready(function () {
            console.log('dropdown1');
            $('#state-dropdown').change(function () {
                var stateId = $(this).val();
                if (stateId) {
                    $.getJSON('@Url.Action("GetAllCityByState", "LicenseMaster")', { id: stateId }, function (data) {
                        var items = '<option>Select City</option>';
                        console.log(items);
                        $.each(data, function (i, city) {
                            items += "<option value='" + city.cityId + "'>" + city.cityName + "</option>";
                        });
                        $('#city-dropdown').html(items);
                    }).fail(function (jqXHR, textStatus, errorThrown) {
                        console.error('Error fetching cities: ' + textStatus);
                    });
                } else {
                    $('#city-dropdown').html('<option>Select City</option>');
                }
            });

            $('#city-dropdown').change(function () {
                var cityId = $(this).val();
                if (cityId) {
                    $.getJSON('@Url.Action("GetAllMunicipalByCity", "LicenseMaster")', { id: cityId }, function (data) {
                        var items = '<option>Select Municipal Corporation</option>';
                        $.each(data, function (i, municipal) {
                            items += "<option value='" + municipal.municipalId + "'>" + municipal.municipalName + "</option>";
                        });
                        $('#municipal-dropdown').html(items);
                    }).fail(function (jqXHR, textStatus, errorThrown) {
                        console.error('Error fetching municipal corporations: ' + textStatus);
                    });
                }
            });
        });
    </script>

    @section Scripts {
        @{
            await Html.RenderPartialAsync("_ValidationScriptsPartial");
        }
    }
</body>

@* </html> *@
