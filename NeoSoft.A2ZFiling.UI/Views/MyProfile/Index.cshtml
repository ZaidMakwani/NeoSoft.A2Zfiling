                <hr class="w-50 mx-auto mb-0 mt-0 mb-xl-3 mt-xl-3 border-dark-subtle"> <!-- Adjust mb-xl-9 to mb-xl-3 -->
            </div>
            @if (!string.IsNullOrEmpty(Model.ProfileImagePath))
            {
                <img src="@Url.Content(Model.ProfileImagePath)" alt="Profile Image" class="profile-image" />
            }
            else
            {
                <p>No profile image available</p>
            }
        </div>
    </div>




