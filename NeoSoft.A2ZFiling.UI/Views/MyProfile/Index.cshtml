<style>
    .profile-image {
        height: 200px;
        width: 200px;
        object-fit: cover;
        border-radius: 50%; /* Rounded border for profile image */
        border: 5px solid #fff; /* White border around the image */
        box-shadow: 0 0 20px rgba(0, 0, 0, 0.1); /* Subtle shadow */
        transition: transform 0.3s ease; /* Transition effect */
    }

        .profile-image:hover {
            transform: scale(1.1); /* Scale up on hover */
        }

    .tab-content {
        padding-top: 2rem; /* Space between tabs and content */
    }

    .nav-tabs .nav-link {
        background-color: transparent;
        color: #000;
        border: none;
        border-bottom: 2px solid transparent;
        font-weight: 600;
        transition: border-color 0.3s ease;
    }

        .nav-tabs .nav-link.active {
            border-color: #007bff; /* Active tab underline color */
            color: #007bff; /* Active tab text color */
        }

        .nav-tabs .nav-link:hover {
            border-color: #007bff; /* Hovered tab underline color */
            color: #007bff; /* Hovered tab text color */
        }

    .card.widget-card {
        border: none;
        border-radius: 15px;
        overflow: hidden; /* Ensure content inside card doesn't overflow */
        box-shadow: 0 0 10px rgba(0, 0, 0, 0.1); /* Subtle shadow */
        background-color: #f0faff; /* Very faint light blue background */
        transition: transform 0.3s ease; /* Transition effect */
    }

        .card.widget-card:hover {
            transform: scale(1.02); /* Scale up on hover */
        }

        .card.widget-card .card-body {
            padding: 2rem; /* Padding inside card body */
        }

    .form-label {
        font-weight: 600;
    }

    .form-control {
        border-radius: 8px; /* Rounded corners for form inputs */
    }

    .btn-primary {
        background-color: #007bff; /* Primary button background color */
        border: none;
    }

        .btn-primary:hover {
            background-color: #0056b3; /* Darker shade on button hover */
        }

        .btn-primary:focus {
            box-shadow: 0 0 0 0.2rem rgba(0, 123, 255, 0.5); /* Focus state */
        }

    /* Added border to the page */
    .page-border {
        border: 1px solid #dee2e6; /* Light gray border */
        border-radius: 15px;
        padding: 1rem; /* Padding inside the page border */
    }
</style>


