@{
}

@model NeoSoft.A2ZFiling.UI.ViewModels.AppUserVM;


@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mx-auto" role="alert" style="max-width: 300px; padding: 0.5rem; font-size: 0.875rem;">
        @TempData["SuccessMessage"]
        <button type="button" class="close" data-dismiss="alert" aria-label="Close" style="padding: 0.25rem 0.5rem;">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
}

<head>
    <link rel="stylesheet" href="https://unpkg.com/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>

<style>
    .profile-image {
        height: 200px;
        width: 200px;
        object-fit: cover;
        border-radius: 10%;
        border: 5px solid #fff; 
        box-shadow: 0 0 20px rgba(0, 0, 0, 0.1); 
        transition: transform 0.3s ease; 
    }

        .profile-image:hover {
            transform: scale(1.1); 
        }

    .tab-content {
        padding-top: 2rem; 
    }

    .nav-tabs .nav-link {
        background-color: transparent;
        color: #000;
        border: none;
        border-bottom: 2px solid transparent;
        font-weight: 600;
        transition: border-color 0.3s ease;
    }

        .nav-tabs .nav-link.active {
            border-color: #007bff; 
            color: #007bff; 
        }

        .nav-tabs .nav-link:hover {
            border-color: #007bff; 
            color: #007bff; 
        }

    .card.widget-card {
        border: none;
        border-radius: 15px;
        overflow: hidden; 
        box-shadow: 0 0 10px rgba(0, 0, 0, 0.1); 
        background-color: #fff;
        transition: transform 0.3s ease; 
    }

        .card.widget-card:hover {
            transform: scale(1.02); 
        }

        .card.widget-card .card-body {
            padding: 2rem; 
        }

    .form-label {
        font-weight: 600;
    }

    .form-control {
        border-radius: 8px; 
    }

    .btn-primary {
        background-color: #007bff; 
        border: none;
    }

        .btn-primary:hover {
            background-color: #0056b3; 
        }

        .btn-primary:focus {
            box-shadow: 0 0 0 0.2rem rgba(0, 123, 255, 0.5); 
        }


    .section-border {
        border: 2px solid #007bff;
        border-radius: 15px;
        padding: 1rem; 
        background-color: #f8f9fa; 
    }

  
    .row-color:nth-child(odd) {
        background-color: #e9f7ff; 
    }

    .row-color:nth-child(even) {
        background-color: #f7fbff; 
    }
</style>

@* <section class="bg-light py-3 py-md-1 py-xl-8"> *@
 


   @*  <div class="container mt-3 mb-3">
        <div class="row justify-content-md-center">
            <div class="col-12 col-md-10 col-lg-8 col-xl-7 col-xxl-6 pt-3 pb-3">
                <h2 class="mb-1 display-5 text-center">My Profile</h2>
                <p class="text-secondary text-center lead fs-4 mb-0"></p> 
                <hr class="w-50 mx-auto mb-0 mt-0 mb-xl-3 mt-xl-3 border-dark-subtle"> 
