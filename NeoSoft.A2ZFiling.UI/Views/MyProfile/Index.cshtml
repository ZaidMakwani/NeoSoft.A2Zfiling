    <div class="container mt-5">
        <div class="row gy-4 gy-lg-10">
        
            <div class="col-12 col-lg-8 col-xl-12">
                <div class="card widget-card border-light shadow-sm">
                    <div class="card-body p-4">
                        <ul class="nav nav-tabs" id="profileTab" role="tablist">
                            <li class="nav-item" role="presentation">
                                <button class="nav-link active" id="overview-tab" data-bs-toggle="tab" data-bs-target="#overview-tab-pane" type="button" role="tab" aria-controls="overview-tab-pane" aria-selected="true">Overview</button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link" id="profile-tab" data-bs-toggle="tab" data-bs-target="#profile-tab-pane" type="button" role="tab" aria-controls="profile-tab-pane" aria-selected="false">Profile</button>
                            </li>
                            
                            <li class="nav-item" role="presentation">
                                <button class="nav-link" id="password-tab" data-bs-toggle="tab" data-bs-target="#password-tab-pane" type="button" role="tab" aria-controls="password-tab-pane" aria-selected="false">Password</button>
                            </li>
                        </ul>
                        <div class="tab-content pt-4" id="profileTabContent">

                        <div class="tab-pane fade show active" id="overview-tab-pane" role="tabpanel" aria-labelledby="overview-tab" tabindex="0">
                            <div class="row justify-content-md-center">
                                <!-- Left column for information -->
                                <div class="col-12 col-md-6">
                                    <div class="row g-0">
                                        <div class="col-5 col-md-3 bg-light border-bottom border-white border-3">
                                            <div class="p-2">First Name</div>
                                        </div>
                                        <div class="col-7 col-md-9 bg-light border-start border-bottom border-white border-3">
                                            <div class="p-2">@Model.FirstName</div>
                                        </div>
                                        <div class="col-5 col-md-3 bg-light border-bottom border-white border-3">
                                            <div class="p-2">Last Name</div>
                                        </div>
                                        <div class="col-7 col-md-9 bg-light border-start border-bottom border-white border-3">
                                            <div class="p-2">@Model.LastName</div>
                                        </div>
                                        <div class="col-5 col-md-3 bg-light border-bottom border-white border-3">
                                            <div class="p-2">Username</div>
                                        </div>
                                        <div class="col-7 col-md-9 bg-light border-start border-bottom border-white border-3">
                                            <div class="p-2">@Model.UserName</div>
                                        </div>
                                        <div class="col-5 col-md-3 bg-light border-bottom border-white border-3">
                                            <div class="p-2">Email</div>
                                        </div>
                                        <div class="col-7 col-md-9 bg-light border-start border-bottom border-white border-3">
                                            <div class="p-2">@Model.Email</div>
                                        </div>
                                        <div class="col-5 col-md-3 bg-light border-bottom border-white border-3">
                                            <div class="p-2">Contact Number</div>
                                        </div>
                                        <div class="col-7 col-md-9 bg-light border-start border-bottom border-white border-3">
                                            <div class="p-2">@Model.ContactNumber</div>
                                        </div>
                                        <div class="col-5 col-md-3 bg-light border-bottom border-white border-3">
                                            <div class="p-2">Address</div>
                                        </div>
                                        <div class="col-7 col-md-9 bg-light border-start border-bottom border-white border-3">
                                            <div class="p-2">@Model.Address</div>
                                        </div>
                                    </div>
                                </div>
                                <!-- Right column for profile image -->
                                <div class="col-12 col-md-6  pt-3 pb-3 ">
                                   @*  <h2 class="mb-1 display-5 text-center">My Profile</h2>
                                    <p class="text-secondary text-center lead fs-4 mb-0"></p>
                                    <hr class="w-50 mx-auto mb-0 mt-0 mb-xl-3 mt-xl-3 border-dark-subtle"> *@
                                    @if (!string.IsNullOrEmpty(Model.ProfileImagePath))
                                    {
                                        <img src="@Url.Content(Model.ProfileImagePath)" alt="Profile Image" class="profile-image img-fluid" />
                                    }
                                    else
                                    {
                                        <p>No profile image available</p>
                                    }
                                </div>
                            </div>
                        </div>



                            <div class="tab-pane fade" id="profile-tab-pane" role="tabpanel" aria-labelledby="profile-tab" tabindex="0">
                                <form asp-action="UpdateUser" asp-controller="MyProfile" method="post" class="row gy-3 gy-xxl-4">
                              
                                    <div class="col-12 col-md-6">
                                        <label asp-for="@Model.FirstName" class="form-label">First Name</label>
                                        <input asp-for="@Model.FirstName" type="text" class="form-control" id="inputFirstName" value="@Model.FirstName">
                                        <span asp-validation-for="@Model.FirstName" class="text-danger"></span>
                                    </div>
                                    <div class="col-12 col-md-6">
                                        <label asp-for="@Model.LastName" class="form-label">Last Name</label>
                                        <input asp-for="@Model.LastName" type="text" class="form-control" id="inputLastName" value="@Model.LastName">
                                        <span asp-validation-for="@Model.LastName" class="text-danger"></span>
                                    </div>
                                    <div class="col-12 col-md-6">
                                        <label asp-for="@Model.UserName" class="form-label">UserName</label>
                                        <input asp-for="@Model.UserName" type="text" class="form-control" id="inputEducation" value="@Model.UserName">
                                        <span asp-validation-for="@Model.UserName" class="text-danger"></span>
                                    </div>

                                    <div class="col-12 col-md-6">
                                        <label asp-for="@Model.ContactNumber" class="form-label">Phone</label>
                                        <input asp-for="@Model.ContactNumber" type="number" class="form-control" id="inputPhone" value="@Model.ContactNumber">
                                        <span asp-validation-for="@Model.ContactNumber" class="text-danger"></span>
                                    </div>
                                    <div class="col-12 col-md-6">
                                        <label asp-for="@Model.Email" class="form-label">Email</label>
                                        <input asp-for="@Model.Email" type="email" class="form-control" id="inputEmail" value="@Model.Email">
                                        <span asp-validation-for="@Model.Email" class="text-danger"></span>
                                    </div>
                                    <div class="col-12 col-md-6">
                                        <label asp-for="@Model.Address" class="form-label">Address</label>
                                        <input asp-for="@Model.Address" type="text" class="form-control" id="inputAddress" value="@Model.Address">
                                        <span asp-validation-for="@Model.Address" class="text-danger"></span>
                                    </div>

                                    <div class="col-12">
                                        <button type="submit" class="btn btn-primary">Save Changes</button>
                                    </div>
                                </form>
                            </div>
                          
                            <div class="tab-pane fade" id="password-tab-pane" role="tabpanel" aria-labelledby="password-tab" tabindex="0">
                                <form asp-controller="MyProfile" asp-action="ComparePassword" method="post">
                                    <div class="row gy-3 gy-xxl-4">
                                        <div class="col-12">
                                            <label for="CurrentPassword" class="form-label">Current Password</label>
                                            <input asp-for="@Model.CurrentPassword" type="password" class="form-control" id="inputLastName">
                                            <span asp-validation-for="@Model.CurrentPassword" class="text-danger"></span>

                                        </div>
                                        <div class="col-12">
                                            <label for="NewPassword" class="form-label">New Password</label>
                                            <input asp-for="@Model.NewPassword" type="password" class="form-control" id="inputLastName">
                                            <span asp-validation-for="@Model.NewPassword" class="text-danger"></span>
                                        </div>
                                        <div class="col-12">
                                            <label for="ConfirmPassword" class="form-label">Confirm Password</label>
                                            <input asp-for="@Model.ConfirmPassword" type="password" class="form-control" id="inputLastName">
                                            <span asp-validation-for="@Model.ConfirmPassword" class="text-danger"></span>
                                        </div>
                                        <div class="col-12">
                                            <label for="PasswordCurr" class="form-label"></label>
                                            <input asp-for="@Model.PasswordCurr" type="hidden" class="form-control" id="inputLastName" value="@Model.PasswordCurr">
                                            <span asp-validation-for="@Model.PasswordCurr" class="text-danger"></span>
                                        </div>

                                        <div class="col-12">
                                            <button type="submit" class="btn btn-primary" name="Password">Change Password</button>
                                        </div>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

@* </section> *@


<script src="https://unpkg.com/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}